# Copy to .env.local and fill in values from Supabase Dashboard → Project Settings.

# --- Supabase (API) ---
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-or-publishable-key>
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=<service-role-or-secret-key>

# --- Database (Drizzle) ---
# Copy both from Dashboard → Connect. The pooler host (aws-0-… / aws-1-…) differs
# per project; a wrong one fails with "tenant/user ... not found".
# Runtime: transaction pooler (port 6543).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:6543/postgres
# Migrations (drizzle-kit): session pooler (port 5432).
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres

# --- Stripe ---
# Server-only. Dashboard → Developers → API keys (use sk_test_... locally).
STRIPE_SECRET_KEY=sk_test_<...>
# Webhook signing secret: Dashboard → Webhooks → endpoint, or printed by `stripe listen`.
STRIPE_WEBHOOK_SECRET=whsec_<...>

# --- Gate access (QR) ---
# HS256 key for 30s QR tokens, min 32 chars. Generate: openssl rand -base64 48
ACCESS_TOKEN_SECRET=<random-48-bytes-base64>
# Shared key the gate hardware sends as `Authorization: Bearer <key>`.
GATE_API_KEY=<random-32-bytes-hex>


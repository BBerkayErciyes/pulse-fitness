# Copy to .env.local and fill in values from Supabase Dashboard → Project Settings.

# --- Supabase (API) ---
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-or-publishable-key>
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=<service-role-or-secret-key>

# --- Database (Drizzle) ---
# Runtime: transaction pooler (port 6543).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Migrations (drizzle-kit): direct / session connection (port 5432).
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# --- Webhooks ---
WEBHOOK_SIGNING_SECRET=<payment-provider-webhook-secret>
